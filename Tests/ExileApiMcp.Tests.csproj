<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests without a test framework (no extra packages): "dotnet run (project Tests)" runs every check in
       Program.cs and exits non-zero on a failure. CI runs it (.github/workflows/build.yml). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExileApiMcp.csproj" />
  </ItemGroup>
</Project>
