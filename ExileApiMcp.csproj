<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- One executable, two transports: stdio (default; Claude Code / Claude Desktop config) and
       the http switch (stateless Streamable HTTP on 127.0.0.1). See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExileApiMcp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MCPEXP003: the MCP Apps extension is experimental in the 2.x SDK. -->
    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" Version="2.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- MCP App UI bundles (single-file HTML built from ui-src in a container; see ui-src/README.md). -->
    <EmbeddedResource Include="ui\*.html" LogicalName="ui/%(Filename)%(Extension)" />
    <!-- The UI's TypeScript sources and npm files are not part of the .NET build (the Web SDK would
         otherwise copy every *.json into the output). -->
    <Content Remove="ui-src\**" />
    <None Remove="ui-src\**" />
    <Compile Remove="ui-src\**" />
  </ItemGroup>
</Project>
