<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- One executable, two transports: stdio (default; Claude Code / Claude Desktop config) and
       the http switch (stateless Streamable HTTP on 127.0.0.1). See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExileApiMcp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MCPEXP003: the MCP Apps extension is experimental in the 2.x SDK. -->
    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
    <!-- Not an IIS app: no web.config in publish output (desktop-extension\pack.ps1 publishes). -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" Version="2.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Offline type metadata of the HUD DLLs (hud_find_types / hud_type): reads, never executes. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- MCP App UI bundles (single-file HTML built from ui-src in a container; see ui-src/README.md). -->
    <EmbeddedResource Include="ui\*.html" LogicalName="ui/%(Filename)%(Extension)" />
    <!-- Knowledge packs served by the knowledge tool / exile://knowledge/{game}/{topic}. -->
    <EmbeddedResource Include="Knowledge\**\*.md" LogicalName="knowledge/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Knowledge\findings.json" LogicalName="knowledge/findings.json" />
    <!-- The UI's TypeScript sources and npm files are not part of the .NET build (the Web SDK would
         otherwise copy every *.json into the output). -->
    <Content Remove="ui-src\**;desktop-extension\**" />
    <None Remove="ui-src\**;desktop-extension\**" />
    <Compile Remove="ui-src\**;desktop-extension\**" />
  </ItemGroup>
</Project>
