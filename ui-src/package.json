{
  "name": "exileapi-mcp-ui",
  "private": true,
  "type": "module",
  "description": "MCP App UIs for ExileApiMcp. Built in a container by build.ps1; only ../ui/*.html is kept.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:app": "vite build",
    "build:explorer": "vite build --mode explorer",
    "build:memory": "vite build --mode memory",
    "build:perf": "vite build --mode perf",
    "build:control": "vite build --mode control",
    "build:harness": "vite build --mode harness",
    "build": "npm run typecheck && npm run build:app && npm run build:explorer && npm run build:memory && npm run build:perf && npm run build:control && npm run build:harness",
    "preview": "vite preview --host 0.0.0.0 --port 5174 --strictPort"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/core": "2.1.0",
    "@modelcontextprotocol/ext-apps": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
