<Project Sdk="Microsoft.NET.Sdk">
  <!-- The stable process between an MCP client and the server it runs (Supervisor/README.md). No packages: it must
       build and start even when the server's dependencies change, and it changes rarely. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExileApiMcp.Supervisor</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
